# DB OCIO Webview 환경변수 템플릿
# 이 파일을 repo 루트에 `.env` 로 복사하고 실제 값을 채우세요. (.env 는 gitignore)

# MariaDB (필수 — 대시보드 전 기능)
OCIO_DB_HOST=192.168.195.55
OCIO_DB_USER=solution
OCIO_DB_PASSWORD=

# 한국은행 ECOS API (성과분석 Brinson USDKRW 환율 — 미설정 시 DB fallback 경로에 따라 일부 기능 제한)
ECOS_API_KEY=

# 이하 리서치 배치(market_research) 전용 — 대시보드 서빙만 하면 불필요
FINNHUB_API_KEY=
NEWSAPI_KEY=
# ANTHROPIC_API_KEY=   # 운용보고 debate/코멘트 생성 시
